<!DOCTYPE html>
<html>
<head>
  <title><%= data.title %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      padding: 40px;
    }

    .card {
      max-width: 800px;
      background: #fff;
      margin: auto;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .header {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    img {
      width: 160px;
      border-radius: 8px;
    }

    h1 {
      margin: 0;
    }

    .description {
      color: #555;
      font-size: 16px;
    }

    .extract {
      margin-top: 20px;
      line-height: 1.6;
      color: #333;
    }

    a {
      display: inline-block;
      margin-top: 20px;
      color: #1a73e8;
      text-decoration: none;
      font-weight: bold;
    }

    a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

  <div class="card">
    <div class="header">
      <% if (data.thumbnail) { %>
        <img src="<%= data.thumbnail %>" alt="<%= data.title %>">
      <% } %>

      <div>
        <h1><%= data.title %></h1>
        <p class="description"><%= data.description %></p>
      </div>
    </div>

    <div class="extract">
      <%= data.extract %>
    </div>

    <a href="<%= data.page %>" target="_blank">
      Read more on Wikipedia →
    </a>
  </div>

</body>
</html>
